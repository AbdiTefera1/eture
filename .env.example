# PostgreSQL connection string. Works with Neon, Supabase, Railway, or a local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/selam_ethiopia?schema=public"

# First admin account, created by the seed script.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Random long string used to sign admin session cookies.
SESSION_SECRET="replace-with-a-long-random-string"
